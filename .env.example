# Beispiel-Umgebungsvariablen — kopieren nach `.env.local` (gitignored).
#
# Lokal: Werte stammen aus der Ausgabe von `npx supabase start`
#   (API URL = VITE_SUPABASE_URL, anon key = VITE_SUPABASE_ANON_KEY).
# Produktion: aus dem Supabase-Dashboard (EU-Region) bzw. dem Hosting-Provider.

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=

# Stripe (Phase 4) — im Frontend ausschließlich der publishable Key.
# Secret-/Webhook-Keys leben NUR in den Supabase Edge Functions.
VITE_STRIPE_PUBLISHABLE_KEY=
